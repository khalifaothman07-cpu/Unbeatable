# Supabase — LU'LU'A online seats.
#
# This is the PUBLISHABLE (anon) key. It is designed to ship inside browser
# bundles and is already embedded in the committed build output, so keeping
# it out of the repo would protect nothing while guaranteeing that a future
# rebuild silently produces a bundle with online play disabled.
#
# Security comes from Row Level Security, not from hiding this key. The
# policy grants anon read/write on public.luluaa_games ONLY — no other table
# in this project is reachable with it. The room code is the shared secret.
#
# NEVER put the service_role key here. That one bypasses RLS entirely.
VITE_SUPABASE_URL=https://ngtpeamcaxdtghimdspz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Td08KXJimYLQIbwS3fpPEA_-AfRp_Jl
